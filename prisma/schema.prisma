  userId        String   @map("user_id")
  documentType  String   @map("document_type")
  label         String?
  fileUrl       String   @map("file_url")
  fileType      String   @map("file_type")
  extractedText String?  @map("extracted_text") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, documentType])
  @@map("UserDocumentTemplate")
}

model Evolution {
  id                       String                    @id @default(uuid())
  patientId                String
  /**
   * Marcação de origem (evoluir do slot na agenda). Opcional para evoluções avulsas.
   */
  appointmentId            String?                   @unique @map("appointment_id")
  /**
   * NATIVE = criada no AI Evolui; IMPORTED = trazida de outra plataforma (Nura, Zenfysio, etc.).
   */
  source                   EvolutionSource           @default(NATIVE)
  /**
   * Agrupa todas as evoluções de um mesmo lote de importação.
   */
  importBatchId            String?                   @map("import_batch_id")
  /**
   * Plataforma de origem declarada pelo profissional (NURA | ZENFYSIO | OUTRO).
   */
  importedFrom             String?                   @map("imported_from") @db.VarChar(32)
  content                  String?                   @db.Text
  rawData                  String?                   @db.Text
  date                     DateTime                  @default(now())
  pdfUrl                   String?
  examFiles                String[]
  tags                     String[] // Tags para filtros rapidos e nuvem de tags (ex: ["Joelho", "LCA", "Fisioterapia"])
  clinicalMeta             Json? // Metadados clinicos estruturados por profissao (ex: { anatomia, patologia, intervencao })
  /**
   * Ações sugeridas para o profissional (checklist / lembretes) — formato em src/lib/evolution-artifacts.ts
   */
  professionalActions      Json?
  /**
   * Pontos-chave e recomendações para o paciente (linguagem acessível) — distinto de professionalActions
   */
  patientHandout           Json?
  /**
   * Medicamentos e suplementos mencionados (nome, dose, efeitos, interações) — formato em src/lib/evolution-artifacts.ts
   */
  medicationsAndSupplements Json?
  /**
   * Intra User que registrou a evolução (perfil ativo). Usado no painel
   * administrativo do Consultório Financeiro (Consultório/Clínica).
   */
  attendingIntraUserId     String?                   @map("attending_intra_user_id")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  patient                  Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment              Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  attendingIntraUser       IntraUser?                @relation("EvolutionAttendingIntraUser", fields: [attendingIntraUserId], references: [id], onDelete: SetNull)
  sessionConsumptionEvents SessionConsumptionEvent[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([date])
  @@index([tags])
  @@index([importBatchId])
  @@index([source])
  @@index([attendingIntraUserId])
}

/**
