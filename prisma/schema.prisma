   * Quando a métrica veio de análise de exame/ficheiro na Pasta de Exames.
   */
  patientExamId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientExam PatientExam? @relation(fields: [patientExamId], references: [id], onDelete: SetNull)

  @@index([patientId, date])
  @@index([name])
  @@index([patientExamId])
}

// Pasta Exames/Documentos: uploads manuais (PRO) e PDFs gerados por IA (FREE+)
model PatientExam {
