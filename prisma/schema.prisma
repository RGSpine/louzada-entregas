// Métricas clínicas estruturadas para a "Evolução Visual" do paciente
model PatientMetric {
  id              String   @id @default(uuid())
  patientId       String
  name            String // Ex: "Nível de Dor", "Mobilidade", "Força"
  value           Float // Escala numérica (ex: 0 a 10)
  date            DateTime // Data associada ao marco (ex: data da evolução ou do atendimento)
  isAutoGenerated Boolean  @default(false) // true = extraído automaticamente pela IA
  /**
   * Unidade ou escala informada pela IA (ex: EVA, graus, kg).
