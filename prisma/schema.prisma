generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL") // Pooler (porta 6543) - usado pelo Prisma Client
  directUrl         = env("DIRECT_URL") // Direct (porta 5432) - usado por migrations/introspect
  // Opcional: Postgres dedicado ao shadow (ex.: `aievolui_shadow` no docker-compose.dev-db.yml).
  // Sem esta URL o Prisma cria o shadow no mesmo servidor — falha em alguns hosts sem schema `auth`.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Enum para sistema de cargos (Roles)
enum Role {
  USER
  ADMIN
}

/**
 * Nível de permissão do Intra User (sub-usuário de conta de equipe).
 * ADMIN: acesso total (financeiro global, relatórios, gestão de equipe).
 * MEMBER: acesso restrito (só seus pacientes/compartilhados; financeiro limitado).
 */
enum IntraUserRole {
  ADMIN
  MEMBER
}

/**
 * Origem do ficheiro na pasta Exames/Documentos do paciente
 */
enum PatientExamSource {
  MANUAL_UPLOAD
  AI_GENERATED
}

/**
 * Origem da evolução clínica (nativa vs importada de outra plataforma).
 */
enum EvolutionSource {
  NATIVE
  IMPORTED
}

/**
 * Estado da marcação na agenda própria do profissional
 */
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/**
 * Origem do agendamento (voz e sync Google nas fases seguintes)
 */
enum AppointmentSource {
  MANUAL
  VOICE
  OCR
  GOOGLE_SYNC
}

/**
 * Tipo de atendimento na agenda (multi-profissão).
 */
enum AppointmentVisitKind {
  UNIQUE_CONSULTATION
  RETURN
  TREATMENT_PLAN
}

/**
 * Onde o atendimento ocorre.
 */
enum AppointmentCareSetting {
  IN_PERSON_CLINIC
  ONLINE
  HOME_VISIT
}

/**
 * Estado de confirmação do paciente/evento na agenda (cores Starter+).
 */
enum AppointmentConfirmationStatus {
  PENDING_CONFIRMATION
  CONFIRMED
}

/**
 * Estado do processamento híbrido da Nova Evolução.
 */
enum EvolutionProcessingJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

/**
 * Compra pontual ou pacote de sessões ligada ao catálogo do profissional.
 */
enum PatientServicePurchaseType {
  SINGLE
  PACKAGE
}

/**
 * Forma de cobrança do serviço/venda.
 * SESSION = avulso ou pacote de N sessões; MONTHLY = mensalidade (pilates, acompanhamento…).
 */
enum ServiceBillingMode {
  SESSION
  MONTHLY
}

enum PatientServiceSessionStatus {
  PENDING
  CONSUMED
  WAIVED
  CANCELLED
}

enum FinancialTransactionKind {
  INCOME
  EXPENSE
}

enum FinancialTransactionMethod {
  CASH
  PIX
  CARD
  TRANSFER
  OTHER
}

/**
 * Origem do consumo automático/manual de sessão no pacote.
 */
enum SessionConsumptionSource {
  APPOINTMENT_COMPLETED
  EVOLUTION_RECORDED
  MANUAL
}

/**
 * Natureza da despesa: fixa (recorrente, salva) ou variável (flutuante).
 * Só se aplica a transações EXPENSE; receitas ficam null.
 */
enum ExpenseNature {
  FIXED
  VARIABLE
}

/**
 * Proveniência de um lançamento financeiro (auditoria do Agente Financeiro).
 */
enum FinancialEntrySource {
  MANUAL
  AUDIO
  PHOTO
  AGENT
  RECURRING
  AGENDA
  /** Despesa de repasse/comissão a Intra User (Consultório/Clínica). */
  COLLABORATOR_PAYOUT
}

/**
 * Período de apuração do balanço/repasse dos colaboradores.
 * Isolado dos presets do relatório geral (não inclui dia/trimestre/etc.).
 */
enum CollaboratorPayoutPeriod {
  WEEK
  FORTNIGHT
  MONTH
}

/**
 * Frequência de uma despesa fixa recorrente.
 */
enum RecurringExpenseFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/**
 * Regime tributário do profissional (export fiscal Fase 0).
 */
enum FiscalRegime {
  PF_CARNE_LEAO
  PJ_SIMPLES
  PJ_PRESUMIDO
  UNSPECIFIED
}

/**
 * Estado de preparação/exportação fiscal de uma receita (Fase 0).
 */
enum FiscalExportStatus {
  NOT_APPLICABLE
  PENDING
  READY
  EXPORTED
}

/**
 * Estado de emissão NFS-e (Fase 1 — provedor externo).
 */
enum FiscalDocumentStatus {
  QUEUED
  PROCESSING
  ISSUED
  ERROR
  CANCELLED
}

enum FiscalProviderKind {
  NOTAAS
  FOCUS
}

/**
 * Estado do emitente PJ no provedor (Fase 1.1 — multi-CNPJ).
 */
enum FiscalIssuerStatus {
  PENDING_SETUP
  PROJECT_REGISTERED
  CERTIFICATE_ACTIVE
  ERROR
}

enum FiscalCertificateStatus {
  NONE
  ACTIVE
  EXPIRED
  ERROR
}

/**
 * Estado do horário no marketplace (Yield Management).
 * AVAILABLE: ofertado; BOOKED: reservado (lock de concorrência);
 * BLOCKED: bloqueado pelo profissional (fora do marketplace).
 */
enum ScheduleSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

model User {
  id            String    @id @default(cuid())
  authUserId    String?   @unique @map("auth_user_id") // UUID do Supabase Auth; usado por RLS/PostgREST quando habilitado
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER) // Sistema de cargos: USER ou ADMIN
  isBlocked     Boolean   @default(false) // Controle de acesso: usuário bloqueado não pode acessar
  /**
   * Acesso PRO via parceria (marketing); sem Stripe; definido só pelo ADMIN
   */
  isInfluencer  Boolean   @default(false) @map("is_influencer")

  // --- Campos de Perfil (Todos Opcionais no Banco para suportar Google Auth) ---
  avatarUrl     String? // (Opcional, caso queira uma foto diferente do Google)
  phone         String?
  profession    String?
  councilType   String?
  councilNumber String? // <--- Opcional (Regra do Estudante)
  officeAddress String?
  clinicLogoUrl String?

  /**
   * Perfil fiscal (Fase 0 — export Receita Saúde / preparação NFS-e).
   */
  fiscalRegime            FiscalRegime @default(UNSPECIFIED) @map("fiscal_regime")
  professionalCpf         String?      @map("professional_cpf") @db.VarChar(11)
  professionalCnpj        String?      @map("professional_cnpj") @db.VarChar(14)
  carneLeaoOccupationCode String?      @map("carne_leao_occupation_code") @db.VarChar(3)
  /**
   * NFS-e (PJ): código de serviço municipal / LC 116 (ex.: 04.01). Validado pelo contador.
   */
  nfseServiceCode         String?      @map("nfse_service_code") @db.VarChar(20)
  /**
   * NFS-e (PJ): alíquota ISS em percentual (ex.: 2.0 = 2%).
   */
  nfseIssAliquotaPercent  Float?       @map("nfse_iss_aliquota_percent")

  // --- Campos de Billing (Stripe) ---
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  stripePriceId         String?   @map("stripe_price_id")
  currentPeriodEnd      DateTime? @map("current_period_end")
  /**
   * Stripe `cancel_at_period_end` — cancelamento agendado (ainda ativo até currentPeriodEnd).
   * Alimenta alerta CRM CANCEL_SCHEDULED para follow-up do dono da plataforma.
   */
  stripeCancelAtPeriodEnd Boolean @default(false) @map("stripe_cancel_at_period_end")
  /**
   * Plano comercial. "NONE" = pré-checkout (nunca BASICO automático).
   * Valores: NONE | BASICO | PROFISSIONAL | PREMIUM | CONSULTORIO | CLINICA
   * Legado: PENDING/INCOMPLETE tratados como incompletos no código.
   */
  plan                  String    @default("NONE")
  /**
   * Ciclo de vida da conta. Novos usuários = INCOMPLETE.
   * ACTIVE só após checkout.session.completed (webhook Stripe) ou isenção (influencer/admin).
   * Valores: INCOMPLETE | ACTIVE | BLOCKED
   */
  accountStatus         String    @default("INCOMPLETE") @map("account_status")
  planInterval          String?   @map("plan_interval") // "MONTHLY" ou "ANNUAL"
  /**
   * Novos cadastros: exige escolha de plano + checkout Stripe antes de liberar o produto.
   * Default true — qualquer create que esquecer o flag permanece bloqueado.
   */
  basicoCheckoutRequired Boolean  @default(true) @map("basico_checkout_required")
  /** Preenchido quando o cadastro inicial dos operadores da conta foi concluído. */
  teamSetupCompletedAt DateTime? @map("team_setup_completed_at") @db.Timestamptz(6)
  /** E-mail de aviso de fim do gratuito legado enviado. */
  legacyFreeSunsetNoticeSentAt DateTime? @map("legacy_free_sunset_notice_sent_at")
  /** Fim do período de graça de 7 dias (base legada sem assinatura). */
  legacyFreeSunsetEndsAt     DateTime? @map("legacy_free_sunset_ends_at")
  // Controle de cupom: cada usuário pode resgatar no máximo 1 cupom no ciclo de vida.
  couponRedemptionCode  String?   @map("coupon_redemption_code")
  couponRedeemedAt      DateTime? @map("coupon_redeemed_at")
  evolutionCount        Int       @default(0) // Contador mensal (resetar por ciclo)
  evolutionCountResetAt DateTime? @map("evolution_count_reset_at") // Data do último reset mensal
  /**
   * Contador mensal de importações de histórico de outra plataforma (não conta como evolução nova).
   */
  historyImportCount        Int       @default(0) @map("history_import_count")
  historyImportCountResetAt DateTime? @map("history_import_count_reset_at")
  patientCount          Int       @default(0) // Contador absoluto

  /**
   * Última sync automática Google Agenda ↔ AI.Evolui (cron).
   */
  googleCalendarLastSyncedAt DateTime? @map("google_calendar_last_synced_at") @db.Timestamptz(6)
  /**
   * Período de testes: e-mail Google informado pelo profissional para cadastro manual pelo admin.
   */
  googleCalendarManualEmail       String?   @map("google_calendar_manual_email")
  googleCalendarManualRequestedAt DateTime? @map("google_calendar_manual_requested_at") @db.Timestamptz(6)
  /**
   * Quando o admin conclui o cadastro manual e libera OAuth para o profissional.
   */
  googleCalendarManualApprovedAt  DateTime? @map("google_calendar_manual_approved_at") @db.Timestamptz(6)

  /**
   * Preferências de entrega do PDF após gerar evolução.
   * Salvamento no paciente (histórico/pasta) é sempre obrigatório.
   */
  autoDownloadNewEvolution Boolean @default(true) @map("auto_download_new_evolution")
  emailNewEvolution        Boolean @default(true) @map("email_new_evolution")

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  patients                    Patient[]
  goals                       UserGoal[]
  /**
   * Rótulos curtos memorizados por CID-10 para o Perfil Clínico (1–2 palavras por código).
   */
  cidProfileLabels            UserCidProfileLabel[]
  /**
   * Modelos de documento enviados pelo utilizador (referência para geração com IA)
   */
  documentTemplates           UserDocumentTemplate[]
  appointments                Appointment[]
  evolutionProcessingJobs     EvolutionProcessingJob[]
  /**
   * Jobs IA para extração financeira (áudio longo → segundo plano).
   */
  officeFinanceExtractionJobs OfficeFinanceExtractionJob[]
  /**
   * Jobs do Agente Financeiro (áudio longo → segundo plano).
   */
  financeAgentJobs            FinanceAgentJob[]
  /**
   * Catálogo de serviços e preços (consultório).
   */
  professionalServices        ProfessionalService[]
  /**
   * Espaços de Serviços (Consultório/Clínica): salas/unidades com caixa e agenda próprios.
   */
  serviceSpaces               ServiceSpace[]
  /**
   * Pacotes/avulsos vendidos aos pacientes.
   */
  patientServicePurchases     PatientServicePurchase[]
  /**
   * Livro-caixa do consultório.
   */
  financialTransactions       FinancialTransaction[]
  /**
   * Repasses de comissão a Intra Users (Consultório/Clínica).
   */
  collaboratorPayouts         CollaboratorPayout[]
  /**
   * Despesas fixas recorrentes do consultório.
   */
  recurringExpenses           RecurringExpense[]
  /**
   * Sessões do chat clínico por paciente (PRO).
   */
  patientChatSessions         PatientChatSession[]
  accessSessions              UserAccessSession[]
  pushSubscriptions           PushSubscription[]
  pushNotificationDeliveries  PushNotificationDelivery[]
  /**
   * IDs do inbox do sino já marcados como lidos (JSON string[]).
   * Novos itens (id diferente) voltam a aparecer no badge.
   */
  dashboardInboxReadIds       Json?                        @map("dashboard_inbox_read_ids")
  clinicalRecommendationsCache ClinicalRecommendationsCache?
  fiscalDocuments             FiscalDocument[]
  fiscalIssuerProfile         FiscalIssuerProfile?

  /** CRM comercial (Camada B — pós-signup). */
  crmProfile                  CrmAccountProfile?
  crmReferralsMade            CrmAccountProfile[]      @relation("CrmReferrals")
  crmAdminNotesAuthored       CrmAdminNote[]           @relation("CrmAdminNotes")

  accounts Account[]
  sessions Session[]

  /**
   * Sub-usuários (profissionais) da conta de equipe (Consultório/Clínica).
   * O Tenant é este User; os Intra Users compartilham a mesma credencial.
   */
  intraUsers IntraUser[]

  /**
   * Perfil público B2B do profissional no marketplace (geo + yield).
   */
  professionalProfile ProfessionalProfile?

  dentistClients   DentistClient[]
  logisticsIntakes LogisticsIntake[]
  logisticsTasks   LogisticsTask[]
}

/**
 * Sub-usuário (Intra User) atrelado à conta pagante (Tenant = User).
 *
 * A autenticação continua via credencial única do Tenant. Os Intra Users são
 * perfis internos usados para segregação de dados por profissional e RBAC
 * (ADMIN vs MEMBER) dentro dos planos Consultório/Clínica. Quantidade máxima:
 * `maxIntraUsersForPlan` (Consultório=5, Clínica=10) — constante de app, não coluna.
 * O perfil ativo é resolvido por cookie após o login (seletor de perfil).
 */
model IntraUser {
  id        String        @id @default(cuid())
  userId    String        @map("user_id") // Tenant/conta pagante (User Prisma)
  name      String
  /**
   * Cor HEX (#RRGGBB) usada para colorir os atendimentos deste profissional na agenda.
   */
  color     String        @default("#2563EB") @map("color") @db.VarChar(7)
  role      IntraUserRole @default(MEMBER)
  /**
   * MEMBER: se false, não cadastra/baixa sessões nem planos na ficha do paciente
   * (aba Serviços / Fiscal). ADMIN ignora este flag (sempre pode).
   * O titular ADMIN controla por perfil em Meu Perfil → Equipe.
   */
  canManagePatientServices Boolean @default(true) @map("can_manage_patient_services")
  /** Executor das coletas e entregas. Não opera o painel como Suzana ou Ellen. */
  isMotoboy Boolean @default(false) @map("is_motoboy")
  /** Entregador inativo sai das novas rotas e permanece nas marcações já feitas. */
  active Boolean @default(true) @map("is_active")
  /** Vezes em que o nome do administrador principal mudou depois do cadastro inicial. */
  nameRevision Int @default(0) @map("name_revision")
  /**
   * Comissão do Intra User em basis points (0–10000 = 0%–100%).
   * Definida livremente pelo ADMIN do tenant; cada perfil pode ter % diferente.
   * Só aplica a Consultório/Clínica — armazenamento por tenant (userId).
   */
  commissionRateBps Int @default(0) @map("commission_rate_bps")
  /**
   * Dono da conta (primeiro Intra User). Sempre ADMIN e não pode ser excluído.
   */
  isOwner   Boolean       @default(false) @map("is_owner")
  /**
   * Hash scrypt do PIN do perfil ADMIN (Opção B). MEMBER não usa PIN.
   * Nunca exponha este campo ao cliente — só `hasPin` booleano.
   */
  pinHash     String?   @map("pin_hash")
  pinUpdatedAt DateTime? @map("pin_updated_at")
  /** PIN em claro, só para o administrador principal ver e alterar no próprio perfil. */
  pinCode     String?   @map("pin_code") @db.VarChar(4)
  /** Telefone do entregador, para a ligação a partir do painel e dos registros. */
  phone       String?   @map("phone") @db.VarChar(40)
  /** Hash do link de troca do PIN. Só o administrador principal usa. */
  pinResetTokenHash String?   @map("pin_reset_token_hash")
  pinResetExpiresAt DateTime? @map("pin_reset_expires_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedPatients       Patient[]     @relation("PatientOwner")
  appointments        Appointment[] @relation("AppointmentIntraUser")
  recordedEvolutions  Evolution[]   @relation("EvolutionAttendingIntraUser")
  financialTransactions FinancialTransaction[]
  collaboratorPayouts CollaboratorPayout[]
  logisticsIntakesCreated LogisticsIntake[] @relation("LogisticsIntakeCreator")
  logisticsTasksAsMotoboy LogisticsTask[]   @relation("LogisticsTaskMotoboy")

  @@index([userId])
  @@map("IntraUser")
}

/// Sessões ativas por dispositivo (controle de acessos simultâneos por plano).
/// Tetos: individuais (Stripe ou influencer)=1 último login vence; Consultório=5; Clínica=10.
model UserAccessSession {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  deviceId    String   @map("device_id")
  platform    String   @default("web") // web | mobile | desktop
  deviceLabel String?  @map("device_label")
  /** IP do último claim/login neste aparelho (x-forwarded-for). */
  ipAddress   String?  @map("ip_address")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
  @@map("user_access_session")
}

/// Cache diário de Indicações (Ester) gerado a partir do Perfil Clínico.
model ClinicalRecommendationsCache {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  /** Snapshot serializado: items, rationale, profileTags, sessionsAnalyzed, generatedAt */
  payload            Json
  /** Fingerprint do Perfil Clínico no momento da geração (top tags + foco). */
  profileFingerprint String   @map("profile_fingerprint")
  generatedAt        DateTime @map("generated_at")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("clinical_recommendations_cache")
}

/// Inscrição Web Push (PWA Android/iOS 16.4+) por dispositivo/navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// Evita reenvio da mesma notificação (action item ou lembrete de agenda).
model PushNotificationDelivery {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  dedupeKey String   @map("dedupe_key")
  kind      String
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, sentAt])
  @@map("push_notification_delivery")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Patient {
  id                      String                   @id @default(uuid())
  userId                  String?
  /**
   * Intra User (profissional) que criou/possui este paciente. Base da segregação
   * intra-tenant: um MEMBER só vê pacientes onde ownerId == seu id OU isShared.
   */
  ownerId                 String?                  @map("owner_id")
  /**
   * Paciente compartilhado com toda a equipe da clínica (visível a todos os Intra Users do Tenant).
   */
  isShared                Boolean                  @default(false) @map("is_shared")
  name                    String
  /**
   * Placeholder interno da agenda Google — não aparece em listas clínicas (documentos, pacientes).
   */
  agendaOnly              Boolean                  @default(false) @map("agenda_only")
  age                     String?
  diagnosis               String?
  history                 String?                  @db.Text
  clinicalSummary         String?                  @db.Text // Resumo clínico atualizado gerado pela IA
  /**
   * Tópicos sucintos do caso ({ v, bullets }) — gerados com o resumo (updatePatientSummary).
   */
  clinicalCaseHighlights  Json?                    @map("clinical_case_highlights")
  metrics                 Json? // Métricas numéricas históricas (EVA, peso, amplitude, etc)
  lastVisit               DateTime? // Data da última evolução (facilita ordenação)
  /**
   * Cor opcional na agenda (#RRGGBB). Null = cor automática estável por paciente.
   */
  agendaColor             String?                  @map("agenda_color") @db.VarChar(7)
  /**
   * CPF do beneficiário (11 dígitos) — opcional até export fiscal.
   */
  cpf                     String?                  @db.VarChar(11)
  /**
   * CPF de quem pagou, quando diferente do beneficiário.
   */
  payerCpf                String?                  @map("payer_cpf") @db.VarChar(11)
  /**
   * Consentimento LGPD para uso dos dados em exportação fiscal.
   */
  fiscalDataConsentAt     DateTime?                @map("fiscal_data_consent_at") @db.Timestamptz(6)
  /**
   * Identidade B2C (marketplace). Null = ficha clínica só B2B.
   * Unique: um login Supabase Auth = um perfil de paciente no marketplace.
   */
  authUserId              String?                  @unique @map("auth_user_id")
  /**
   * Contato do perfil B2C. Não unique: fichas B2B de profissionais distintos
   * podem repetir e-mail/telefone sem conta marketplace.
   */
  email                   String?
  phone                   String?
  fatherName              String?                  @map("father_name") @db.VarChar(200)
  motherName              String?                  @map("mother_name") @db.VarChar(200)
  companionName           String?                  @map("companion_name") @db.VarChar(200)
  companionPhone          String?                  @map("companion_phone") @db.VarChar(40)
  /**
   * Data de nascimento (fonte da idade automática na ficha e nas evoluções).
   */
  dateOfBirth             DateTime?                @map("date_of_birth") @db.Date
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner                   IntraUser?               @relation("PatientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  evolutions              Evolution[]
  visualMetrics           PatientMetric[] // Nova: métricas clínicas estruturadas para "Evolução Visual"
  exams                   PatientExam[] // Pasta de Exames (PRO): imagens/PDFs de exames e fichas
  appointments            Appointment[]
  patientServicePurchases PatientServicePurchase[]
  financialTransactions   FinancialTransaction[]
  chatSession             PatientChatSession?
  scheduleSlots           ScheduleSlot[]
  /**
   * Perfis do Mapa de Saúde B2C (titular + dependentes na mesma conta).
   */
  healthProfiles          HealthProfile[]
  googleCalendarAccount   PatientGoogleCalendarAccount?
  showcaseInquiries       ShowcaseInquiry[]
  showcaseMessages        ShowcaseMessage[]
  showcaseDualBookings    ShowcaseDualBooking[]
  sharedHealthUpdates     SharedHealthUpdate[]
  mapInvites              ProfessionalMapInvite[]

  @@index([userId])
  @@index([userId, agendaOnly])
  @@index([ownerId])
  @@index([userId, ownerId])
  @@index([name])
  @@index([lastVisit])
  @@index([email])
}

/**
 * Uma thread de chat clínico por profissional + paciente (PRO).
 */
model PatientChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  patientId String   @unique @map("patient_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient  Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
